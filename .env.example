# --- where memory lives ---
MEMORY_BACKEND=local                 # local | drive
LOCAL_MEMORY_PATH=demo_data/memories.md
# DRIVE_FOLDER_ID=xxxxxxxxxxxx       # a DEMO folder shared with the service account only
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# --- retrieval ---
RETRIEVER=keyword                    # keyword | bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=<a model id enabled in your Bedrock account>

# --- network ---
HOST=127.0.0.1                       # 0.0.0.0 when deployed
PORT=8000
# MCP_BEARER_TOKEN=<long random string>   # required when HOST is not localhost
# ALLOWED_HOSTS=your-service.awsapprunner.com
