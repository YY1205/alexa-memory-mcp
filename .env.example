# --- where memory lives ---
MEMORY_BACKEND=local                 # local | drive
LOCAL_MEMORY_PATH=demo_data/memories.md
# DRIVE_FOLDER_ID=xxxxxxxxxxxx       # a DEMO folder shared with the service account only (Editor);
#                                    # upload memories.md yourself: the server never creates it
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/alexa-memory-mcp/service-account.json  # path only; keep it outside the repo
# MEMORY_REFRESH_SECONDS=30          # pick up hand edits to the file (5 for a live demo)

# --- network ---
HOST=127.0.0.1                       # 0.0.0.0 when deployed
PORT=8000
# ALLOWED_HOSTS=your-service.awsapprunner.com
# MCP_RESOURCE_URI=https://your-service.awsapprunner.com/mcp   # canonical MCP URI (token audience)

# --- OAuth 2.1 account linking (required when HOST is not localhost) ---
# OAUTH_CLIENT_ID=<the client id you register in the Alexa developer console>
# OAUTH_CLIENT_SECRET=<long random string>
# OAUTH_REDIRECT_URIS=<comma-separated redirect URIs shown in the Alexa console>
# OWNER_PASSPHRASE_HASH=scrypt$...    # from: python -m auth.passphrase (never the passphrase itself)
# OAUTH_ISSUER=https://your-service.awsapprunner.com   # default: origin of MCP_RESOURCE_URI
# OAUTH_TOKEN_STORE=.oauth/tokens.json # hashed tokens; gitignored
# OAUTH_ACCESS_TTL=900
# OAUTH_TRUST_PROXY=1                  # rate-limit by X-Forwarded-For behind a load balancer

# --- localhost development only (refused on a public host) ---
# MCP_BEARER_TOKEN=<long random string>

# --- demo only ---
# DEMO_ADMIN=1                       # enables POST /admin/reset (restores the fictional demo data)
# DEMO_TODAY=2026-10-22              # pin "today" (review dates) for tests or a recording
